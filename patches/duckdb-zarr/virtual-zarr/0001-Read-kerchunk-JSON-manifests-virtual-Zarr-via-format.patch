+
+        twin = xr.Dataset({"0": (spec["dims"], spec["data"])})
+        twin.to_zarr(twin_path, zarr_format=2, consolidated=True,
+                     encoding={"0": spec["v2_enc"]})
+        print(f"  wrote {refs_path}")
+
     print("\nAll fixtures written.")
 
 
