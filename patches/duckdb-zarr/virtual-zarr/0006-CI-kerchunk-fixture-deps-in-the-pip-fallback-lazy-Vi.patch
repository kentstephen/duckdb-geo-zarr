         if spec["nodata"] is not None:
             # GDAL_NODATA tag (42113): virtual-tiff turns it into the fill value.
@@ -827,6 +833,7 @@ def main() -> None:
             kwargs["planarconfig"] = spec["planar"]
         tifffile.imwrite(tif_path, spec["data"], **kwargs)
 
