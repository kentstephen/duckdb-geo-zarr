+/// Resolve the textual bounds of a spec to raw coordinate values. A bound is
+/// a number, or (when the coordinate carries CF `units` of the form
+/// `<unit> since <epoch>`) an ISO date or date-time, converted into the
+/// coordinate's own units. Only the standard / gregorian / proleptic_gregorian
+/// calendars are supported for date bounds.
+pub fn resolve_dim_range(
+    spec: &DimRangeSpec,
+    coord: Option<&CoordArray>,
+) -> Result<DimRange, Box<dyn std::error::Error>> {
     let bound = |s: &str, default: f64| -> Result<f64, Box<dyn std::error::Error>> {
         if s.is_empty() {
-            Ok(default)
-        } else {
-            s.parse::<f64>()
-                .map_err(|_| format!("range '{item}': '{s}' is not a number").into())
+            return Ok(default);
         }
+        if let Ok(v) = s.parse::<f64>() {
+            return Ok(v);
+        }
+        let dim = &spec.dim;
+        let units = coord.and_then(|c| c.units.as_deref()).ok_or_else(|| {
+            format!("range '{dim}': '{s}' is not a number and '{dim}' has no CF time units")
+        })?;
+        let calendar = coord.and_then(|c| c.calendar.as_deref());
+        cf_time_to_units(s, units, calendar)
+            .map_err(|e| format!("range '{dim}': cannot resolve '{s}': {e}").into())
     };
     Ok(DimRange {
-        dim: dim.to_string(),
-        lo: bound(lo, f64::NEG_INFINITY)?,
-        hi: bound(hi, f64::INFINITY)?,
+        dim: spec.dim.clone(),
+        lo: bound(&spec.lo, f64::NEG_INFINITY)?,
+        hi: bound(&spec.hi, f64::INFINITY)?,
     })
 }
 
+/// Resolve every spec against the loaded coordinates (`None` for unindexed dims).
+pub fn resolve_dim_ranges(
+    specs: &[DimRangeSpec],
+    coord_arrays: &HashMap<String, CoordArray>,
+) -> Result<Vec<DimRange>, Box<dyn std::error::Error>> {
+    specs
+        .iter()
+        .map(|s| resolve_dim_range(s, coord_arrays.get(&s.dim)))
+        .collect()
+}
+
+/// Convert an ISO date/date-time to a value in CF `units` (`<unit> since <epoch>`).
+pub fn cf_time_to_units(
+    value: &str,
+    units: &str,
+    calendar: Option<&str>,
+) -> Result<f64, Box<dyn std::error::Error>> {
+    match calendar.map(|c| c.to_ascii_lowercase()).as_deref() {
+        None | Some("standard") | Some("gregorian") | Some("proleptic_gregorian") => {}
+        Some(other) => return Err(format!("calendar '{other}' is not supported").into()),
+    }
+    let (unit, epoch) = units
+        .split_once(" since ")
+        .ok_or_else(|| format!("units '{units}' are not '<unit> since <epoch>'"))?;
+    let unit_seconds = match unit.trim().to_ascii_lowercase().as_str() {
+        "seconds" | "second" | "secs" | "sec" | "s" => 1.0,
+        "minutes" | "minute" | "mins" | "min" => 60.0,
+        "hours" | "hour" | "hrs" | "hr" | "h" => 3600.0,
+        "days" | "day" | "d" => 86400.0,
+        u => return Err(format!("time unit '{u}' is not supported").into()),
+    };
+    let epoch_s = iso_to_unix_seconds(epoch.trim())?;
+    let value_s = iso_to_unix_seconds(value)?;
+    Ok((value_s - epoch_s) / unit_seconds)
+}
+
+/// Seconds since 1970-01-01T00:00:00 for `YYYY-MM-DD[[T| ]HH[:MM[:SS[.fff]]]][Z]`
+/// on the proleptic Gregorian calendar. Also accepts CF epochs like `1-1-1`.
+fn iso_to_unix_seconds(s: &str) -> Result<f64, Box<dyn std::error::Error>> {
+    let s = s.trim().trim_end_matches('Z');
+    let bad = || -> Box<dyn std::error::Error> { format!("'{s}' is not an ISO date-time").into() };
+    let (date, time) = match s.find(['T', ' ']) {
+        Some(i) => (&s[..i], Some(s[i + 1..].trim())),
+        None => (s, None),
+    };
+    let mut d = date.split('-');
+    let y: i64 = d.next().ok_or_else(bad)?.parse().map_err(|_| bad())?;
+    let m: i64 = d.next().ok_or_else(bad)?.parse().map_err(|_| bad())?;
+    let day: i64 = d.next().ok_or_else(bad)?.parse().map_err(|_| bad())?;
+    if d.next().is_some() || !(1..=12).contains(&m) || !(1..=31).contains(&day) {
+        return Err(bad());
+    }
+    let mut secs = 0.0;
+    if let Some(t) = time.filter(|t| !t.is_empty()) {
+        let mut parts = t.split(':');
+        let h: f64 = parts.next().ok_or_else(bad)?.parse().map_err(|_| bad())?;
+        let mi: f64 = parts
+            .next()
+            .map_or(Ok(0.0), |p| p.parse())
+            .map_err(|_| bad())?;
+        let se: f64 = parts
+            .next()
+            .map_or(Ok(0.0), |p| p.parse())
+            .map_err(|_| bad())?;
+        if parts.next().is_some() || !(0.0..24.0).contains(&h) || !(0.0..60.0).contains(&mi) {
+            return Err(bad());
+        }
+        secs = h * 3600.0 + mi * 60.0 + se;
+    }
+    Ok(days_from_civil(y, m, day) as f64 * 86400.0 + secs)
+}
+
+/// Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's algorithm).
+fn days_from_civil(y: i64, m: i64, d: i64) -> i64 {
+    let y = if m <= 2 { y - 1 } else { y };
+    let era = if y >= 0 { y } else { y - 399 } / 400;
+    let yoe = y - era * 400;
+    let doy = (153 * (if m > 2 { m - 3 } else { m + 9 }) + 2) / 5 + d - 1;
+    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+    era * 146097 + doe - 719468
+}
