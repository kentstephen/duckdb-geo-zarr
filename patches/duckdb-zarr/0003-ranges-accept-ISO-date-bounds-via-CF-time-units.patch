+/// One `dim:lo:hi` item as written, before the bounds are resolved against
+/// the coordinate array (see `resolve_dim_range`).
+#[derive(Debug, Clone, PartialEq)]
+pub struct DimRangeSpec {
+    pub dim: String,
+    pub lo: String,
+    pub hi: String,
+}
+
+/// Split one `dim:lo:hi` item. Either bound may be empty (`time:1000:` is
+/// "time >= 1000"). The dim name is the text before the first `:`. Because an
+/// ISO time-of-day bound contains colons itself (`time:2020-07-01T00:00:2020-07-02`),
+/// the `lo:hi` separator is the colon at which both sides are well-formed
+/// bound tokens (empty, a number, or an ISO date / date-time).
+pub fn parse_dim_range_spec(item: &str) -> Result<DimRangeSpec, Box<dyn std::error::Error>> {
+    let err = || -> Box<dyn std::error::Error> {
+        format!("range '{item}' must look like 'dim:lo:hi' (bounds may be empty)").into()
+    };
+    let (dim, rest) = item.split_once(':').ok_or_else(err)?;
+    let (lo, hi) = split_bounds(rest).ok_or_else(err)?;
+    Ok(DimRangeSpec {
+        dim: dim.trim().to_string(),
+        lo: lo.to_string(),
+        hi: hi.to_string(),
+    })
+}
+
+/// Find the unique `:` in `lo:hi` at which both sides are bound tokens.
+fn split_bounds(rest: &str) -> Option<(&str, &str)> {
+    let mut found = None;
+    for (i, _) in rest.match_indices(':') {
+        let (lo, hi) = (rest[..i].trim(), rest[i + 1..].trim());
+        if is_bound_token(lo) && is_bound_token(hi) {
+            if found.is_some() {
+                return None; // ambiguous
+            }
+            found = Some((lo, hi));
+        }
+    }
+    found
+}
+
+/// Empty, a number, or `YYYY-MM-DD[[T| ]HH[:MM[:SS[.fff]]]][Z]`.
+fn is_bound_token(s: &str) -> bool {
+    if s.is_empty() || s.parse::<f64>().is_ok() {
+        return true;
+    }
+    let s = s.strip_suffix('Z').unwrap_or(s);
+    let (date, time) = match s.find(['T', ' ']) {
+        Some(i) => (&s[..i], Some(&s[i + 1..])),
+        None => (s, None),
+    };
+    let mut d = date.split('-');
+    let date_ok = (0..3).all(|_| {
+        d.next()
+            .is_some_and(|p| !p.is_empty() && p.bytes().all(|c| c.is_ascii_digit()))
+    }) && d.next().is_none();
+    if !date_ok {
+        return false;
+    }
+    match time {
+        None => true,
+        Some(t) => {
+            let parts: Vec<&str> = t.split(':').collect();
+            (1..=3).contains(&parts.len())
+                && parts.iter().enumerate().all(|(k, p)| {
+                    !p.is_empty()
+                        && p.bytes()
+                            .all(|c| c.is_ascii_digit() || (k == 2 && c == b'.'))
+                })
+        }
     }
-    let (hi, lo, dim) = (parts[0].trim(), parts[1].trim(), parts[2].trim());
+}
